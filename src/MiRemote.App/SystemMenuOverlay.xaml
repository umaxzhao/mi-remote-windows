<Window x:Class="MiRemote.App.SystemMenuOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统功能菜单" Height="360" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="#CC1E1E1E"
        Topmost="True" ShowActivated="False" ResizeMode="NoResize">
    <Border CornerRadius="10" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="8">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="系统功能菜单" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" Foreground="White" BorderThickness="0"/>
            <TextBlock Grid.Row="2" Foreground="#AAAAAA" FontSize="10" Margin="0,8,0,0"
                       Text="↑↓ 选择  OK 执行  返回 关闭"/>
        </Grid>
    </Border>
</Window>
