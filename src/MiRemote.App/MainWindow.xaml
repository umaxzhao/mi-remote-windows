<Window x:Class="MiRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiRemote" Height="720" Width="980"
        MinWidth="820" MinHeight="560"
        Background="#F5F5F7" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="ContentBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GroupBorder" Color="#E4E4E6"/>
        <SolidColorBrush x:Key="Hairline" Color="#E5E5E7"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#86868B"/>
        <SolidColorBrush x:Key="Accent" Color="#0066FF"/>
        <SolidColorBrush x:Key="RowHover" Color="#F0F0F2"/>

        <Style x:Key="NavListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,14,10,10"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,6" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Icon" Width="20" Height="20" CornerRadius="5" Background="#8E8E93" Margin="0,0,9,0">
                                    <TextBlock x:Name="IconGlyph" Text="●" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding}" Foreground="#3C3C3E" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0000000B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Icon" Property="Background" Value="#FFFFFF44"/>
                                <Setter TargetName="IconGlyph" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GroupBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,22,2,6"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="#D7D7DB" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,10,20">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1C1C1E">
                        <TextBlock Text="M" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MiRemote" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Windows 版" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="NavList" Style="{StaticResource NavListStyle}" ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="按键映射" Tag="mapping"/>
                    <ListBoxItem Content="Profile" Tag="profile"/>
                    <ListBoxItem Content="语音" Tag="voice"/>
                    <ListBoxItem Content="常规" Tag="general"/>
                    <ListBoxItem Content="日志" Tag="log"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Background="{StaticResource ContentBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,26,34,40">
                <Grid>
                    <!-- Mapping page -->
                    <StackPanel x:Name="PageMapping" Visibility="Visible">
                        <TextBlock Text="按键映射" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="点击左侧列表中的按键，编辑该键的短按 / 长按 / 双击 / 手势行为。" Style="{StaticResource PageDescStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="KeyList" Grid.Column="0" BorderBrush="{StaticResource GroupBorder}" BorderThickness="1" Background="White" Padding="4"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="当前按键" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="CurrentKeyLabel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="短按" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TapBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="{StaticResource GroupBorder}" Padding="8"/>
                                <TextBlock Text="长按" Style="{StaticResource GroupLabelStyle}" Margin="0,10,0,6"/>
                                <TextBox x:Name="HoldBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="{StaticResource GroupBorder}" Padding="8"/>
                                <TextBlock Text="双击" Style="{StaticResource GroupLabelStyle}" Margin="0,10,0,6"/>
                                <TextBox x:Name="DoubleBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="{StaticResource GroupBorder}" Padding="8"/>
                                <TextBlock Text="动作格式：JSON，如 {&quot;type&quot;:&quot;key_stroke&quot;,&quot;key&quot;:&quot;return&quot;,&quot;mods&quot;:[]}" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <Button Content="保存此键" Click="SaveKey_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Profile page -->
                    <StackPanel x:Name="PageProfile" Visibility="Collapsed">
                        <TextBlock Text="Profile" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="每个 App 可覆盖全局映射的一部分按键，未声明的键继承全局设置。" Style="{StaticResource PageDescStyle}"/>
                        <TextBlock Text="内置预设" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <ListBox x:Name="PresetList" BorderThickness="0" Background="Transparent" Height="220"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="应用预设" Click="ApplyPreset_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="强制覆盖" Click="ApplyPresetForce_Click" Margin="0,0,0,0" Padding="14,6"/>
                        </StackPanel>
                        <TextBlock Text="配置文件" Style="{StaticResource GroupLabelStyle}" Margin="0,12,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <StackPanel Margin="14,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="导出 config.json" Click="ExportConfig_Click" Padding="14,6" Margin="0,0,8,0"/>
                                    <Button Content="重新加载" Click="ReloadConfig_Click" Padding="14,6"/>
                                </StackPanel>
                                <TextBlock x:Name="ConfigPathText" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Voice page -->
                    <StackPanel x:Name="PageVoice" Visibility="Collapsed">
                        <TextBlock Text="语音" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Windows 版暂未移植 ATVV BLE 语音链路；语音键默认触发系统听写 (Win+H)。" Style="{StaticResource PageDescStyle}"/>
                        <TextBlock Text="常规" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="语音回退行为" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VoiceFallbackBox" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="dictation（系统听写 Win+H）"/>
                                    <ComboBoxItem Content="none（忽略）"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- General page -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <TextBlock Text="常规" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="设备、阈值与运行状态。" Style="{StaticResource PageDescStyle}"/>
                        <TextBlock Text="设备状态" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <StackPanel Margin="14,10">
                                <TextBlock x:Name="DeviceStatus" Text="未连接" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="运行" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource RowStyle}">
                                    <DockPanel>
                                        <TextBlock Text="暂停遥控" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="PauseCheck" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                                    <DockPanel>
                                        <TextBlock Text="启动时自动监听" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="StartEnabledCheck" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="阈值" Style="{StaticResource GroupLabelStyle}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource RowStyle}">
                                    <DockPanel>
                                        <TextBlock Text="长按阈值 (ms)" VerticalAlignment="Center"/>
                                        <TextBox x:Name="HoldMsBox" DockPanel.Dock="Right" Width="80" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowStyle}">
                                    <DockPanel>
                                        <TextBlock Text="双击窗口 (ms)" VerticalAlignment="Center"/>
                                        <TextBox x:Name="DoubleMsBox" DockPanel.Dock="Right" Width="80" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                                    <DockPanel>
                                        <TextBlock Text="按键重复延迟 (ms)" VerticalAlignment="Center"/>
                                        <TextBox x:Name="RepeatDelayBox" DockPanel.Dock="Right" Width="80" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button Content="保存并应用" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock Text="日志（最近）" Style="{StaticResource GroupLabelStyle}" Margin="0,12,0,6"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <TextBox x:Name="LogTail" Height="200" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="10"/>
                        </Border>
                    </StackPanel>

                    <!-- Log page -->
                    <StackPanel x:Name="PageLog" Visibility="Collapsed">
                        <TextBlock Text="日志" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="完整运行日志。" Style="{StaticResource PageDescStyle}"/>
                        <Border Style="{StaticResource GroupStyle}">
                            <TextBox x:Name="FullLog" Height="520" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="10"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
