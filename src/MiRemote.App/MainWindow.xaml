<Window x:Class="MiRemote.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MiRemote 设置" Icon="Assets/icon.png" Width="1100" Height="800" MinWidth="920" MinHeight="650" Background="White" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#F3F3F5"/><Setter Property="BorderBrush" Value="#E1E1E5"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#86868B"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,20"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#DDDDDF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E8E8EA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F6F6F7" CornerRadius="16" Margin="10"><DockPanel Margin="12,20">
   <StackPanel DockPanel.Dock="Top" Margin="4,0,0,26" Orientation="Horizontal"><Image Source="Assets/icon.png" Width="40" Height="40" Margin="0,0,10,0"/><TextBlock Text="遥控器控制台" FontSize="17" FontWeight="Bold"/><TextBlock Text="MI RC 2 Pro · Windows" Foreground="#86868B" Margin="0,6,0,0"/></StackPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="MiRemote" Foreground="#A0A0A6" Margin="12"/>
   <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" SelectionChanged="NavList_SelectionChanged"><ListBoxItem Content="♧   按键映射" Tag="mapping"/><ListBoxItem Content="▣   Profile" Tag="profile"/><ListBoxItem Content="♩   语音" Tag="voice"/><ListBoxItem Content="⚙   通用" Tag="general"/></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="26,26,28,18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <StackPanel x:Name="PageMapping">
    <TextBlock Text="按键映射" Style="{StaticResource Title}"/><TextBlock Text="点击左侧遥控器上的按键，编辑它的触发动作。改动即时保存并生效。" Style="{StaticResource Hint}"/>
    <DockPanel Margin="0,0,0,20"><TextBlock Text="编辑 Profile" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="ProfileSelector" MinWidth="200" HorizontalAlignment="Left" Padding="8,5" SelectionChanged="ProfileSelector_SelectionChanged" AutomationProperties.AutomationId="ProfileSelector"/></DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#FAFBFB" CornerRadius="14" Margin="0,0,22,0" Padding="10,16"><StackPanel><Viewbox Stretch="Uniform" Height="470"><ContentControl x:Name="RemoteHost" Width="180" Height="480"/></Viewbox><TextBlock x:Name="RemoteStatus" Text="等待遥控器连接" HorizontalAlignment="Center" Foreground="#86868B" Margin="0,12,0,0"/><TextBlock Text="点击实体按键位置选择，选中按键以蓝色描边高亮。" Foreground="#A0A0A6" TextWrapping="Wrap" TextAlignment="Center" Margin="4,20,4,4" FontSize="11"/></StackPanel></Border>
     <StackPanel Grid.Column="1"><DockPanel Margin="0,0,0,20"><Border Background="#3478F6" CornerRadius="10" Width="42" Height="42" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock x:Name="KeyBadge" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock x:Name="CurrentKeyLabel" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="UsageLabel" Foreground="#86868B" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <TextBlock Text="触发方式" Foreground="#86868B" FontWeight="SemiBold" Margin="0,0,0,8"/><Border BorderBrush="#E2E2E5" BorderThickness="1" CornerRadius="10"><StackPanel x:Name="TriggerRows"/></Border>
      <StackPanel x:Name="GestureSection" Margin="0,22,0,0"><TextBlock Text="手势（按住 OK + 方向键）" Foreground="#86868B" FontWeight="SemiBold" Margin="0,0,0,8"/><Border BorderBrush="#E2E2E5" BorderThickness="1" CornerRadius="10"><StackPanel x:Name="GestureRows"/></Border></StackPanel>
      <Expander Header="第二功能模式（高级）" Margin="0,22,0,0" AutomationProperties.AutomationId="AdvancedLayers"><StackPanel><TextBlock Text="功能层激活时替代该键的短按。" Foreground="#86868B" Margin="0,10"/><Border BorderBrush="#E2E2E5" BorderThickness="1" CornerRadius="10"><StackPanel x:Name="LayerRows"/></Border></StackPanel></Expander>
      <TextBlock x:Name="SaveStatus" Text="选择动作后自动保存。组合键可点击「录制快捷键」。" Foreground="#86868B" FontSize="11" TextWrapping="Wrap" Margin="0,22,0,0"/>
     </StackPanel>
    </Grid>
   </StackPanel>
   <StackPanel x:Name="PageProfile" Visibility="Collapsed"><TextBlock Text="Profile" Style="{StaticResource Title}"/><TextBlock Text="应用 Profile 只覆盖修改过的动作，其余槽位继承全局映射。进程名使用小写且不带 .exe。" Style="{StaticResource Hint}"/><Button Content="添加应用 Profile…" Click="AddProfile_Click" HorizontalAlignment="Left"/><TextBlock Text="内置预设" Margin="0,24,0,8"/><ListBox x:Name="PresetList" Height="230" BorderBrush="#E2E2E5"/><StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="应用预设" Click="ApplyPreset_Click"/><Button Content="强制覆盖…" Click="ApplyPresetForce_Click"/></StackPanel><TextBlock x:Name="ConfigPathText" Foreground="#86868B" TextWrapping="Wrap" Margin="0,20"/><StackPanel Orientation="Horizontal"><Button Content="导出配置…" Click="ExportConfig_Click"/><Button Content="重新加载" Click="ReloadConfig_Click"/></StackPanel></StackPanel>
   <StackPanel x:Name="PageVoice" Visibility="Collapsed"><TextBlock Text="语音" Style="{StaticResource Title}"/><TextBlock Text="把遥控器语音键绑定到输入法的语音输入：按住遥控器语音键说话，松开结束。豆包输入法 Windows 版默认用「长按右 Alt」触发。" Style="{StaticResource Hint}"/><TextBlock Text="语音触发方式" Margin="0,0,0,6"/><ComboBox x:Name="VoiceFallbackBox" Width="380" HorizontalAlignment="Left" Padding="8"><ComboBoxItem Content="豆包输入法（长按右 Alt 说话）"/><ComboBoxItem Content="Windows 系统听写（Win+H）"/><ComboBoxItem Content="关闭"/></ComboBox><TextBlock Text="触发键（豆包默认 right_alt；改过豆包快捷键就填同一组合，如 win+ctrl）" Margin="0,18,0,6"/><TextBox x:Name="VoiceKeyBox" Width="380" HorizontalAlignment="Left" Padding="6"/><TextBlock Text="触发模式" Margin="0,18,0,6"/><ComboBox x:Name="VoiceModeBox" Width="380" HorizontalAlignment="Left" Padding="8"><ComboBoxItem Content="hold（按住说话，松开结束）"/><ComboBoxItem Content="tap（按一下开始/再按结束）"/></ComboBox><TextBlock x:Name="VoiceDriverStatus" Margin="0,14,0,6" Foreground="#86868B" TextWrapping="Wrap"/><Button Content="安装语音驱动（需管理员确认）" Click="InstallDriver_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/><Button Content="保存语音设置" Click="SaveVoice_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
   <StackPanel x:Name="PageGeneral" Visibility="Collapsed"><TextBlock Text="通用" Style="{StaticResource Title}"/><TextBlock Text="设备、监听与触发阈值。" Style="{StaticResource Hint}"/><TextBlock x:Name="DeviceStatus" Text="等待遥控器连接" Margin="0,0,0,20"/><CheckBox x:Name="PauseCheck" Content="暂停遥控" Margin="0,8"/><CheckBox x:Name="StartEnabledCheck" Content="启动时自动监听" Margin="0,8"/><TextBlock Text="长按阈值（ms）" Margin="0,18,0,6"/><TextBox x:Name="HoldMsBox" Width="120" HorizontalAlignment="Left" Padding="6"/><TextBlock Text="双击窗口（ms）" Margin="0,18,0,6"/><TextBox x:Name="DoubleMsBox" Width="120" HorizontalAlignment="Left" Padding="6"/><TextBlock Text="重复延迟（ms，-1 关闭）" Margin="0,18,0,6"/><TextBox x:Name="RepeatDelayBox" Width="120" HorizontalAlignment="Left" Padding="6"/><Button Content="保存通用设置" Click="Save_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel>
  </StackPanel></ScrollViewer></Grid>
 </Grid>
</Window>
