<Window x:Class="MiRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiRemote - Windows 版" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="Tabs">
            <TabItem Header="常规">
                <StackPanel Margin="12">
                    <TextBlock Text="设备状态" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="DeviceStatus" Text="未连接" Margin="0,0,0,12"/>
                    <CheckBox x:Name="PauseCheck" Content="暂停遥控" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="长按阈值(ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="HoldMsBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="双击窗口(ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DoubleMsBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="重复延迟(ms):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="RepeatDelayBox" Width="80"/>
                    </StackPanel>
                    <Button Content="保存并应用" Click="Save_Click" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Text="日志（最近）" FontWeight="Bold" Margin="0,12,0,6"/>
                    <TextBox x:Name="LogTail" Height="260" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="映射">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="KeyList" SelectionChanged="KeyList_SelectionChanged"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Tap 动作" FontWeight="Bold"/>
                        <TextBox x:Name="TapBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8"/>
                        <TextBlock Text="Hold 动作"/>
                        <TextBox x:Name="HoldBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8"/>
                        <TextBlock Text="Double 动作"/>
                        <TextBox x:Name="DoubleBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8"/>
                        <TextBlock Text="动作格式：JSON，如 {&quot;type&quot;:&quot;key_stroke&quot;,&quot;key&quot;:&quot;return&quot;,&quot;mods&quot;:[]}" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                        <Button Content="保存此键" Click="SaveKey_Click" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="配置">
                <StackPanel Margin="12">
                    <TextBlock Text="内置预设" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="PresetList" Height="200"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="应用预设" Click="ApplyPreset_Click" Width="120" Margin="0,0,8,0"/>
                        <Button Content="强制覆盖" Click="ApplyPresetForce_Click" Width="120"/>
                    </StackPanel>
                    <TextBlock Text="配置文件" FontWeight="Bold" Margin="0,8,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导出 config.json" Click="ExportConfig_Click" Width="140" Margin="0,0,8,0"/>
                        <Button Content="重新加载" Click="ReloadConfig_Click" Width="120"/>
                    </StackPanel>
                    <TextBlock x:Name="ConfigPathText" FontSize="10" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="日志">
                <TextBox x:Name="FullLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="8"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
